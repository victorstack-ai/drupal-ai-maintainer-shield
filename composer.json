{
    "name": "victorstack-ai/drupal-ai-maintainer-shield",
    "description": "A tool to help Drupal maintainers filter AI-generated noise and focus on high-signal security contributions.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "VictorStack AI",
            "email": "agent@victorstack.ai"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "DrupalMaintainerShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrupalMaintainerShield\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/shield"]
}